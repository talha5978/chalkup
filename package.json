{
	"name": "chalkup",
	"description": "Chalkup turns a spoken sentence into a ledger entry, so small sellers can track who owes them without typing or awkward reminders.",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "react-router build",
		"dev": "react-router dev",
		"start": "react-router-serve ./build/server/index.js",
		"typecheck": "react-router typegen && tsc",
		"format": "prettier --write \"**/*.{js,ts,tsx,jsx,json,md,css,scss}\"",
		"seed": "tsx scripts/seed.ts",
		"seed:reset": "tsx scripts/seed.ts --reset",
		"eval": "tsx scripts/eval.ts"
	},
	"lint-staged": {
		"**/*.{js,ts,tsx,jsx,json,md,css,scss}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@react-router/node": "^8.5.1",
		"@react-router/serve": "^8.5.1",
		"@tanstack/react-table": "^9.3.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.1",
		"dexie": "^4.4.7",
		"fuse.js": "^7.5.0",
		"isbot": "^5.1.36",
		"lucide-react": "^1.66.0",
		"next-themes": "^0.4.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.5.1",
		"react-top-loading-bar": "^3.0.2",
		"shadcn": "^4.23.0",
		"sonner": "^2.0.8",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@react-router/dev": "^8.5.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"dotenv": "^18.0.9",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^8.0.3"
	},
	"author": {
		"name": "Muhammad Talha",
		"email": "muhammadtalha13457@gmail.com",
		"url": "https://github.com/talha5978/"
	}
}
